# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_POOL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Wallet (base58 private key)
WALLET_PRIVATE_KEY=

# Pump.fun WebSocket
PUMPFUN_WS_URL=wss://pumpportal.fun/api/data

# Jupiter API
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Trading Parameters
BUY_AMOUNT_SOL=0.005
SLIPPAGE_BPS=300
MAX_RETRIES=3
RETRY_DELAY_MS=500
MAX_ACTIVE_POSITIONS=10

# Filters
MIN_LIQUIDITY_SOL=5.0
MIN_MARKET_CAP_USD=10000
MAX_MARKET_CAP_USD=1000000
MAX_TOKEN_AGE_SECONDS=60

# AI Providers
GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.1-405b-instruct
AI_FAIL_OPEN_SCORE=0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_ADMIN_IDS=

# Proxies
PROXY_URL=
PROXY_LIST_PATH=data/proxies.txt
RESIDENTIAL_PROXY=

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=INFO
LOG_FILE=solbot.log