# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_POOL=https://api.mainnet-beta.solana.com
# Base58 secret. Prefer WALLET_PRIVATE_KEY_FILE on the VPS (never commit either).
WALLET_PRIVATE_KEY=
WALLET_PRIVATE_KEY_FILE=
USE_JITO=true
JITO_TIP_SOL=0.0005

# Paper trading — runs the full buy/TP/moonbag/exit lifecycle against live
# prices without signing or broadcasting anything. Use this to prove the
# strategy before funding the wallet.
DRY_RUN=false
DRY_RUN_START_SOL=1.3

# Trading Strategy / meme sniper bankroll (env wins; change these, not code)
SNIPER_ENABLED=true
SNIPER_BANKROLL_SOL=1.3
SNIPER_CLIP_SOL=0.25
BUY_AMOUNT_SOL=0.25
SNIPER_MAX_OPEN=3
MAX_ACTIVE_POSITIONS=3
MIN_WALLET_SOL_RESERVE=0.1
SNIPER_SCAN_INTERVAL_SECONDS=1.0
# Optional: override filter-profile delay. Leave empty to keep the profile value.
SNIPER_DELAY_SECONDS=
# pumpfun is required. raydium = graduated coins from the same pump.fun API.
# This repo has no Meteora new-launch watcher (Meteora is arbitrage-only).
SNIPER_SOURCES=pumpfun,raydium
# Secondary trending poll; new launches use the 1s scanner + PumpPortal WS.
SNIPER_MOVERS_INTERVAL_SECONDS=30
SLIPPAGE_BPS=300
MAX_RETRIES=3
RETRY_DELAY_MS=500

# Filters
FILTER_PROFILE=degen
MIN_LIQUIDITY_SOL=5.0
MIN_MARKET_CAP_USD=10000
MAX_MARKET_CAP_USD=1000000
MAX_TOKEN_AGE_SECONDS=60

# AI Providers
# Use either OPENAI_API_KEY or OPENAI_API_KEY_FILE. Do not commit real keys.
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=meta/llama-3.1-405b-instruct
AI_FAIL_OPEN_SCORE=0

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_ADMIN_IDS=

# Proxies
PROXY_URL=
PROXY_LIST_PATH=data/proxies.txt
RESIDENTIAL_PROXY=

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Logging
LOG_LEVEL=INFO
LOG_FILE=solbot.log

# Cross-DEX Arbitrage
ARBITRAGE_ENABLED=false
ARBITRAGE_DRY_RUN=true
ARBITRAGE_WATCH_MINTS=
ARBITRAGE_ROUTE_DEXES=Raydium,Meteora,Orca,Pump.fun
ARBITRAGE_INPUT_SOL=0.10
ARBITRAGE_MIN_PROFIT_SOL=0.02
ARBITRAGE_ESTIMATED_FEES_SOL=0.003
ARBITRAGE_JITO_TIP_SOL=0.001
ARBITRAGE_SCAN_INTERVAL_SECONDS=15
ARBITRAGE_SLIPPAGE_BPS=100
ARBITRAGE_LOG_FILE=arbitrage.log

# Cabal / Developer Cluster Detection
CABAL_DETECTOR_ENABLED=true
CABAL_TOP_HOLDERS_LIMIT=20
CABAL_MAX_CLUSTER_SUPPLY_PCT=30
CABAL_MAX_TRACE_HOPS=3
CABAL_CACHE_TTL_SECONDS=180
AGI_NOTIFICATIONS=true
